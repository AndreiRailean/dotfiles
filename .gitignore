# Per-machine files created on each host from the *.example templates.
# They live inside the stow packages but must never be committed.
shell/.config/shell/local.sh
git/.config/git/local

# Subagent-driven-development scratch (ledger, briefs, review packages).
.superpowers/

# Isolated worktrees for executing plans. Real checkouts live here, so leaving
# them tracked would commit an entire second copy of the repo into itself.
.worktrees/

# herdr keeps runtime state alongside its config in ~/.config/herdr/. Only
# config.toml is tracked; ignore the sockets, logs, and session state so they
# are never committed and doctor.sh doesn't flag them as drift.
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock
# Session recovery copies herdr (0.9+) writes before overwriting session.json.
herdr/.config/herdr/session-snapshots/
# Changelog for the herdr build that happens to be installed on this machine —
# herdr's own data, not our config, and it differs per host by version.
herdr/.config/herdr/release-notes.json

# Python bytecode from running the herdr auto-layout daemon or py_compile.
__pycache__/
*.pyc
