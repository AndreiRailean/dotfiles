#!/usr/bin/env python3
"""Arrange a herdr git-worktree workspace, automatically or on demand.

    ┌────────────────┬────────────────┐   tab 1: "claude"
    │ claude         │ plain shell    │   left pane focused
    └────────────────┴────────────────┘
    tab 2: "lazygit"

Two entry points, one implementation:

    herdr-autolayout                  daemon: arrange every new worktree
    herdr-autolayout arrange [WS_ID]  arrange one workspace now

The second is what the `prefix+shift+l` keybinding in config.toml runs, so the
same layout can be applied by hand — to a workspace that predates the daemon,
or one you have since rearranged. With no argument it targets the workspace it
was invoked from ($HERDR_WORKSPACE_ID, which herdr exports into every pane).

herdr has no declarative hook for the automatic half (no on_worktree_create in
config.toml, and `herdr integration` only manages agent integrations), so the
daemon subscribes to the socket API's event stream. That keeps the native
prefix+shift+G flow untouched and fires however the worktree was made — TUI,
CLI, or API. There is deliberately no attempt to make the daemon "press" the
keybinding: `pane.send_keys` targets a pane's program rather than herdr's input
layer, and registering a real plugin action needs an undocumented plugin
manifest. Calling the same function is simpler and works even when the target
workspace is not focused.

Arranging is idempotent, so pressing the key twice is harmless: the split only
happens when the tab has a single pane, the lazygit tab is reused when one
already exists, and a command is only sent when it is not already running.

Commands are typed into panes with `pane send-text`, because neither
`pane split` nor `tab create` accepts a --command. That makes shell readiness
the whole problem: text sent before the shell reaches its prompt is echoed to
the screen and then discarded, because the newline arrives before readline is
listening. A slow WSL shell (~5s to source rc files here) loses it every time.

Two things guard against that, because neither is sufficient alone:

  * Wait for a prompt, not for the process. `fg == shell_pid` is useless by
    itself — bash is its own foreground process group from the instant it
    spawns. We additionally require the pane to have drawn *something*, which
    no un-initialised shell has done. That stays prompt- and shell-agnostic.
  * Verify, then retry. send-text reports success whenever the bytes were
    delivered, listening shell or not, so afterwards we confirm the process
    actually appears in the pane's foreground group — and if it never does,
    clear the input line and send again.

Two quirks of the 0.7.5 API this works around:

  * `events.wait` looks like it can match workspace events, but the server
    replies `unsupported_event_wait_match` ("currently supports pane agent
    status matches"). So we use events.subscribe, not wait.
  * `SubscriptionEventKind` in the bundled schema only enumerates three
    pane.* kinds, yet workspace_created IS delivered on a subscription.
    Verified against a live server; the schema under-documents it.

Because both of those are undocumented behaviour, a herdr upgrade could
change them. Failures are logged and the loop reconnects rather than dying,
so the worst case is layouts silently stop happening — never a broken herdr.

Config via environment (all optional):
  HERDR_AUTOLAYOUT_LEFT_CMD    command for the left pane (default: claude;
                               empty string leaves it a plain shell)
  HERDR_AUTOLAYOUT_RIGHT_CMD   command for the right pane (default: none)
  HERDR_AUTOLAYOUT_LAZYGIT_CMD lazygit tab command (empty skips the tab)
  HERDR_AUTOLAYOUT_LAZYGIT_TAB label for the lazygit tab (default: lazygit)
  HERDR_AUTOLAYOUT_MAIN_TAB    label for the first tab (default: claude;
                               empty leaves herdr's numbered label alone)
  HERDR_AUTOLAYOUT_FOCUS       left (default) | right | lazygit | none
  HERDR_AUTOLAYOUT_DIRECTION   right (default) | down
  HERDR_AUTOLAYOUT_RATIO       split ratio, e.g. 0.5
  HERDR_AUTOLAYOUT_READY_SECS  seconds to wait for a shell prompt (default 90)
  HERDR_SOCK                   socket path override
"""

import json
import os
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
XDG_STATE = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state")

SOCK = (
    os.environ.get("HERDR_SOCK")
    or os.environ.get("HERDR_SOCKET_PATH")
    or os.path.join(XDG_CONFIG, "herdr", "herdr.sock")
)
LOG = os.path.join(XDG_STATE, "herdr", "autolayout.log")

LEFT_CMD = os.environ.get("HERDR_AUTOLAYOUT_LEFT_CMD", "claude")
RIGHT_CMD = os.environ.get("HERDR_AUTOLAYOUT_RIGHT_CMD", "")
LAZYGIT_CMD = os.environ.get("HERDR_AUTOLAYOUT_LAZYGIT_CMD", "lazygit")
LAZYGIT_TAB = os.environ.get("HERDR_AUTOLAYOUT_LAZYGIT_TAB", "lazygit")
MAIN_TAB = os.environ.get("HERDR_AUTOLAYOUT_MAIN_TAB", "claude")
FOCUS = os.environ.get("HERDR_AUTOLAYOUT_FOCUS", "left")
DIRECTION = os.environ.get("HERDR_AUTOLAYOUT_DIRECTION", "right")
RATIO = os.environ.get("HERDR_AUTOLAYOUT_RATIO", "")
READY_SECS = float(os.environ.get("HERDR_AUTOLAYOUT_READY_SECS", "90"))

# Runtime state lives outside ~/.config/herdr on purpose: doctor.sh treats that
# directory as a managed tree and would report a stray real file as drift.
os.makedirs(os.path.dirname(LOG), exist_ok=True)


def log(msg):
    line = f"{time.strftime('%Y-%m-%d %H:%M:%S')}  {msg}"
    try:
        with open(LOG, "a") as fh:
            fh.write(line + "\n")
    except OSError:
        pass
    print(line, file=sys.stderr, flush=True)


def herdr(*args, timeout=15, quiet=False):
    """Run a herdr CLI command, returning parsed JSON when it emits any.

    quiet suppresses the failure log for calls where a non-zero exit is an
    expected outcome rather than a problem.
    """
    try:
        p = subprocess.run(
            ["herdr", *args], capture_output=True, text=True, timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        log(f"  ! herdr {' '.join(args)} failed: {exc}")
        return None
    if p.returncode != 0:
        if not quiet:
            log(f"  ! herdr {' '.join(args)} exit {p.returncode}: {p.stderr.strip()[:200]}")
        return None
    out = (p.stdout or "").strip()
    if not out:
        return {}
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return {}


def herdr_text(*args, timeout=15):
    """Like herdr(), for the commands that print raw text instead of JSON."""
    try:
        p = subprocess.run(
            ["herdr", *args], capture_output=True, text=True, timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return ""
    return p.stdout if p.returncode == 0 else ""


def panes_of(workspace_id):
    """Set of pane ids in a workspace, plus a pane_id -> tab_id map."""
    data = herdr("pane", "list", "--workspace", workspace_id) or {}
    result = data.get("result", data)
    panes = result.get("panes") if isinstance(result, dict) else None
    if not isinstance(panes, list):
        return set(), {}
    ids = {p.get("pane_id") for p in panes if p.get("pane_id")}
    tabs = {p.get("pane_id"): p.get("tab_id") for p in panes if p.get("pane_id")}
    return ids, tabs


def tabs_of(workspace_id):
    data = herdr("tab", "list", "--workspace", workspace_id) or {}
    return (data.get("result") or {}).get("tabs") or []


def workspace_info(ws_id, quiet=False):
    data = herdr("workspace", "get", ws_id, quiet=quiet)
    if not data:
        return None
    return (data.get("result") or {}).get("workspace")


def panes_in_tab(workspace_id, tab_id):
    ids, tabs = panes_of(workspace_id)
    return sorted(pid for pid in ids if tabs.get(pid) == tab_id)


def new_pane_after(workspace_id, before, action, attempts=20):
    """Run action(), then return the pane id that appeared.

    Neither `pane split` nor `tab create` is documented to return a pane id, so
    diff the workspace's pane set instead of parsing their output.
    """
    if action() is None:
        return None
    for _ in range(attempts):
        after, _ = panes_of(workspace_id)
        fresh = after - before
        if fresh:
            return sorted(fresh)[0]
        time.sleep(0.15)
    return None


def foreground(pane):
    """Names of the processes in the pane's foreground group, plus shell_pid."""
    data = herdr("pane", "process-info", "--pane", pane, quiet=True)
    info = ((data or {}).get("result") or {}).get("process_info") or {}
    names = {q.get("name") for q in info.get("foreground_processes") or [] if q.get("name")}
    return names, info.get("shell_pid"), info.get("foreground_process_group_id")


def prompt_ready(pane, timeout, stable=2, interval=0.4):
    """Wait until the pane's shell has actually printed a prompt.

    `fg == shell_pid` alone is not enough: bash is its own foreground process
    group from the instant it spawns, long before it has sourced rc files or
    drawn a prompt. Text sent in that window gets echoed and thrown away. So
    also require the pane to have produced visible output, which no
    un-initialised shell has. Prompt-agnostic — it does not care what the
    prompt looks like, only that something was drawn.
    """
    deadline = time.time() + timeout
    hits = 0
    while time.time() < deadline:
        _, shell, fg = foreground(pane)
        idle = bool(shell) and fg == shell
        drawn = bool(
            herdr_text(
                "pane", "read", pane, "--source", "visible", "--lines", "8",
                "--format", "text",
            ).strip()
        )
        if idle and drawn:
            hits += 1
            if hits >= stable:
                return True
        else:
            hits = 0
        time.sleep(interval)
    return False


def run_in_pane(pane, cmd, what, attempts=3, settle=12.0):
    """Type cmd into pane, then confirm it actually started.

    Verifying beats trusting: send-text reports success as long as the bytes
    were delivered, even when the shell was not listening. If the process never
    appears we clear the input line and try again, so a shell that is merely
    slow still ends up running the command.
    """
    if not cmd:
        return
    exe = os.path.basename(cmd.split()[0])
    for attempt in range(1, attempts + 1):
        names, _, _ = foreground(pane)
        if exe in names:
            log(f"  {what}: {exe} already running in {pane}")
            return
        if not prompt_ready(pane, READY_SECS):
            log(f"  ! {what}: no prompt within {READY_SECS:g}s; did not send {cmd!r}")
            return
        if attempt > 1:
            # A previous attempt may have left half-typed text on the line;
            # ctrl-u clears it so we do not end up with "claudeclaude".
            herdr("pane", "send-text", pane, "\x15")
        if herdr("pane", "send-text", pane, cmd + "\n") is None:
            log(f"  ! {what}: send-text failed")
            return
        waited = time.time() + settle
        while time.time() < waited:
            names, _, _ = foreground(pane)
            if exe in names:
                suffix = f" (attempt {attempt})" if attempt > 1 else ""
                log(f"  {what}: {exe} running in {pane}{suffix}")
                return
            time.sleep(0.25)
        log(f"  ! {what}: {exe} did not start (attempt {attempt}/{attempts})")
    log(f"  ! {what}: gave up trying to start {cmd!r}")


def pristine(ws_id):
    """Is this workspace still a single untouched pane in a single tab?

    Subscribing replays recent workspace_created events, so the daemon would
    otherwise re-arrange workspaces that were already set up (or ones since
    deleted). Requiring a 1-tab/1-pane workspace means the automatic path never
    touches a workspace you have already shaped. Manual runs skip this check —
    asking for it by keypress is intent enough — and stay safe because
    arranging is idempotent. Returns None when the workspace is gone.
    """
    ws = workspace_info(ws_id, quiet=True)
    if not ws:
        return None
    return ws.get("tab_count") == 1 and ws.get("pane_count") == 1


def arrange(ws):
    """Apply the layout to a workspace dict. Idempotent."""
    ws_id = ws.get("workspace_id")
    tab_id = ws.get("active_tab_id")
    wt = ws.get("worktree") or {}
    cwd = wt.get("checkout_path")
    log(f"arranging {ws_id} ({ws.get('label')})" + (f" at {cwd}" if cwd else ""))

    in_tab = panes_in_tab(ws_id, tab_id)
    if not in_tab:
        log(f"  ! no pane found in {tab_id}; skipping")
        return
    left = in_tab[0]

    # Decide "already split?" from the tab's own pane_count, not from len(in_tab).
    # A manual run happens inside a popup, and while herdr documents a popup as
    # not altering the tab layout, the tab's own count is the authoritative
    # number either way — so a popup can never be mistaken for an existing split.
    tab_meta = next((t for t in tabs_of(ws_id) if t.get("tab_id") == tab_id), None)
    pane_count = tab_meta.get("pane_count") if tab_meta else len(in_tab)

    # Name the main tab, so it reads "claude | lazygit" rather than "1 | lazygit".
    # Skipped when it already matches, to keep repeated runs silent.
    if MAIN_TAB and (not tab_meta or tab_meta.get("label") != MAIN_TAB):
        if herdr("tab", "rename", tab_id, MAIN_TAB) is None:
            log(f"  ! could not rename {tab_id} to {MAIN_TAB!r}")
        else:
            log(f"  renamed {tab_id} -> {MAIN_TAB!r}")

    # ── Build the whole layout first, so every shell boots in parallel ──
    if pane_count and pane_count > 1:
        right = in_tab[1] if len(in_tab) > 1 else None
        log(f"  split already present ({right})")
    else:
        split = ["pane", "split", "--pane", left, "--direction", DIRECTION]
        if RATIO:
            split += ["--ratio", RATIO]
        if cwd:
            split += ["--cwd", cwd]
        before, _ = panes_of(ws_id)
        right = new_pane_after(ws_id, before, lambda: herdr(*split))
        if right:
            log(f"  split {left} {DIRECTION} -> {right}")
        else:
            log("  ! split failed or new pane not found")

    lazygit = None
    if LAZYGIT_CMD:
        existing = next(
            (t for t in tabs_of(ws_id) if t.get("label") == LAZYGIT_TAB), None
        )
        if existing:
            found = panes_in_tab(ws_id, existing.get("tab_id"))
            lazygit = found[0] if found else None
            log(f"  {LAZYGIT_TAB} tab already present ({lazygit})")
        else:
            tab = ["tab", "create", "--workspace", ws_id, "--label", LAZYGIT_TAB,
                   "--no-focus"]
            if cwd:
                tab += ["--cwd", cwd]
            before, _ = panes_of(ws_id)
            lazygit = new_pane_after(ws_id, before, lambda: herdr(*tab))
            if not lazygit:
                log(f"  ! {LAZYGIT_TAB} tab creation failed or new pane not found")

    # ── Focus before the waiting starts, so the layout settles visibly ──
    # `pane focus` moves relative to a pane, so to land on the left pane ask the
    # right one for its left neighbour. Always explicit ids, never --current:
    # this workspace may not be the focused one, and yanking focus out of
    # whatever the user is doing elsewhere would be unforgivable.
    if FOCUS == "left" and right:
        focus_result = herdr("pane", "focus", "--pane", right, "--direction", "left")
    elif FOCUS == "right" and right:
        focus_result = herdr("pane", "focus", "--pane", left, "--direction", DIRECTION)
    elif FOCUS == "lazygit" and lazygit:
        _, tabs = panes_of(ws_id)
        lg_tab = tabs.get(lazygit)
        focus_result = herdr("tab", "focus", lg_tab) if lg_tab else None
    else:
        focus_result = "skipped"
    if focus_result is None:
        log(f"  ! could not focus {FOCUS}")
    elif focus_result != "skipped":
        log(f"  focused {FOCUS}")

    # ── Now type into each pane as its shell becomes usable ──
    run_in_pane(left, LEFT_CMD, "left pane")
    if right:
        run_in_pane(right, RIGHT_CMD, "right pane")
    if lazygit:
        run_in_pane(lazygit, LAZYGIT_CMD, f"{LAZYGIT_TAB} tab")


def handle(event, seen):
    if event.get("event") != "workspace_created":
        return
    ws = (event.get("data") or {}).get("workspace") or {}
    wt = ws.get("worktree") or {}
    # Only linked worktrees. A workspace opened on a repo's main checkout also
    # carries a worktree block, with is_linked_worktree false.
    if not wt.get("is_linked_worktree"):
        return
    ws_id = ws.get("workspace_id")
    if not ws_id or ws_id in seen:
        return
    seen.add(ws_id)
    if len(seen) > 500:
        seen.clear()
        seen.add(ws_id)
    state = pristine(ws_id)
    if state is None:
        log(f"skip {ws_id} ({ws.get('label')}): workspace is gone (replayed event)")
        return
    if not state:
        log(f"skip {ws_id} ({ws.get('label')}): already has extra tabs/panes")
        return
    try:
        arrange(ws)
    except Exception as exc:  # never let one bad event kill the daemon
        log(f"  ! arrange raised: {exc!r}")


def run_once(seen):
    """One connected session. Returns when the connection ends."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    req = {
        "id": "autolayout",
        "method": "events.subscribe",
        "params": {"subscriptions": [{"type": "workspace.created"}]},
    }
    s.sendall((json.dumps(req) + "\n").encode())
    log(f"subscribed via {SOCK}")
    buf = b""
    with s:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if msg.get("error"):
                    log(f"  ! server error: {json.dumps(msg['error'])[:200]}")
                    continue
                handle(msg, seen)


def daemon():
    seen = set()
    backoff = 1
    while True:
        try:
            run_once(seen)
            log("connection closed; reconnecting")
            backoff = 1
        except (FileNotFoundError, ConnectionRefusedError):
            # herdr server not up yet (or restarting for an update).
            pass
        except OSError as exc:
            log(f"socket error: {exc}")
        time.sleep(backoff)
        backoff = min(backoff * 2, 30)


def target_workspace(argv):
    """Which workspace should a manual run arrange?

    An explicit id wins. Otherwise use the workspace we were invoked from:
    herdr exports HERDR_WORKSPACE_ID into every pane, which needs no API call
    and is correct even when the herdr client's focus is elsewhere. Fall back
    to asking the server, then to whichever workspace is focused.
    """
    if argv:
        return argv[0]
    env_ws = os.environ.get("HERDR_WORKSPACE_ID")
    if env_ws:
        return env_ws
    data = herdr("pane", "current", quiet=True)
    pane = ((data or {}).get("result") or {}).get("pane") or {}
    if pane.get("workspace_id"):
        return pane["workspace_id"]
    data = herdr("workspace", "list", quiet=True)
    for ws in ((data or {}).get("result") or {}).get("workspaces") or []:
        if ws.get("focused"):
            return ws.get("workspace_id")
    return None


def arrange_once(argv):
    ws_id = target_workspace(argv)
    if not ws_id:
        log("arrange: could not work out which workspace to arrange")
        return 1
    ws = workspace_info(ws_id)
    if not ws:
        log(f"arrange: workspace {ws_id} not found")
        return 1
    arrange(ws)
    return 0


def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "arrange":
        return arrange_once(argv[1:])
    if argv:
        print(__doc__.strip().splitlines()[0], file=sys.stderr)
        print("usage: herdr-autolayout [arrange [WORKSPACE_ID]]", file=sys.stderr)
        return 2
    daemon()
    return 0


if __name__ == "__main__":
    sys.exit(main())
