{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/adr-probe.sh commit"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/adr-probe.sh subagent"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    }
  },
  "fastModePerSessionOptIn": true,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true
}
