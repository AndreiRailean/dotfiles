{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -r \"$HOME/.claude/hooks/agents-md-probe.sh\" ] && sh \"$HOME/.claude/hooks/agents-md-probe.sh\" || exit 0"
          },
          {
            "type": "command",
            "command": "[ -r \"$HOME/.claude/hooks/behind-probe.sh\" ] && sh \"$HOME/.claude/hooks/behind-probe.sh\" || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -r \"$HOME/.claude/hooks/adr-probe.sh\" ] && sh \"$HOME/.claude/hooks/adr-probe.sh\" commit || exit 0"
          },
          {
            "type": "command",
            "command": "[ -r \"$HOME/.claude/hooks/ff-probe.sh\" ] && sh \"$HOME/.claude/hooks/ff-probe.sh\" merge || exit 0"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "vercel@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "engineering@synced": false
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    }
  },
  "fastModePerSessionOptIn": true,
  "theme": "auto",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "cleanupPeriodDays": 183,
  "skillOverrides": {
    "file-inbox": "off",
    "sentry-cli": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  }
}
